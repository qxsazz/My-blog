---
import '@fontsource-variable/noto-serif-sc';
import { ClientRouter } from 'astro:transitions';
import RouteLoader from '@/components/RouteLoader.astro';
import '@/styles/global.css';
import '@/styles/stellar.css';
import '@/styles/content.css';
import '@/styles/reading.css';
import { site } from '@/config';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Search from '@/components/Search.astro';
import Icon from '@/components/Icon.astro';
import Background from '@/components/Background.astro';
import Subscribe from '@/components/Subscribe.astro';
import Tags from '@/components/Tags.astro';
interface Props { title?: string; description?: string; home?: boolean }
const { title, description = site.description, home = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <ClientRouter fallback="swap" />
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${site.name}` : site.title}</title>
    {Astro.url.pathname.startsWith('/preview/') && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={description} /><meta name="author" content={site.author} /><meta name="theme-color" content="#050b18" /><link rel="preload" href="/fonts/YohakuSans-VF.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:image" content={new URL(site.avatar, Astro.site)} /><link rel="apple-touch-icon" href={site.avatar} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href="/rss.xml" />
    <meta property="og:title" content={title || site.title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:locale" content="zh_CN" /><meta property="og:url" content={canonical} />
    <script is:inline>
      (() => { try { const t = localStorage.getItem('dominator-theme') || 'dark'; document.documentElement.dataset.theme = t === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : t; document.documentElement.dataset.effects = localStorage.getItem('dominator-effects') || 'on'; } catch { document.documentElement.dataset.theme = 'dark'; } })();
    </script>
  </head>
  <body class:list={[{ 'is-home': home }]}>
    <a class="skip-link" href="#main">跳至正文</a>
    <Background />
    <Header />
    <RouteLoader />
    <main id="main" tabindex="-1" transition:animate="none"><slot /></main>
    <Footer /><Search /><Subscribe /><Tags />
    <button class="back-to-top icon-button" aria-label="返回顶部" hidden><Icon name="up" size={18} /></button>
    <script>import '@/scripts/site'; import '@/scripts/transitions';</script>
  </body>
</html>
