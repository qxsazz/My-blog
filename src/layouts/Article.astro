---
import Base from './Base.astro';
import { site } from '@/config';
import Icon from '@/components/Icon.astro';
import { dateLabel, entryUrl, readingTime, type Entry } from '@/lib';
interface Props { entry: Entry; headings: { depth: number; slug: string; text: string }[]; next?: Entry }
const { entry, headings, next } = Astro.props;
const note = entry.collection === 'notes';
---
<Base title={entry.data.title} description={entry.data.description}>
  <div class="article-layout container">
    <article class="article-main">
      <a class="article-back text-link" href={note ? '/notes/' : '/posts/'}>← 返回{note ? '手记' : '文稿'}</a>
      <header class="article-heading"><span class="eyebrow">{note ? 'A NOTE FROM EVERYDAY' : 'WORDS & IDEAS'} <span> / {entry.data.category}</span></span><h1>{entry.data.title}</h1><p class="article-summary">{entry.data.description}</p><div class="article-meta"><a class="article-author" href="/about/" rel="author">{site.author}</a><i>·</i><time datetime={entry.data.date.toISOString()}>{dateLabel(entry.data.date)}</time><i>·</i><span>约 {readingTime(entry.body)} 分钟阅读</span><button class="copy-link" data-copy-link><Icon name="copy" size={13} /><span>复制链接</span></button></div></header>
      <div class="prose"><slot /></div>
      <div class="article-tags">{entry.data.tags.map(tag => <span>#{tag}</span>)}</div>
      <div class="article-signature"><span>✳</span><p>{site.author} <span class="signature-separator">/</span> 谢谢你读到这里。<br /><small>愿这些文字，带给你一点灵感或共鸣。</small></p><a href="/rss.xml" class="text-link">订阅 RSS <Icon name="rss" size={15} /></a></div>
      {next && <a class="next-article" href={entryUrl(next)}><div><span class="eyebrow">继续阅读</span><h2>{next.data.title}</h2></div><Icon name="arrow" /></a>}
    </article>
    <aside class="article-toc"><span class="eyebrow">ON THIS PAGE</span><p>文章目录</p>{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}<a href="#main" class="toc-top">回到开头 ↑</a></aside>
  </div>
</Base>
