---
import type { GetStaticPaths } from "astro";
import Pagination from "../components/control/Pagination.astro";
import PostPage from "../components/PostPage.astro";
import { PAGE_SIZE } from "../constants/constants";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const len = page.data.length;
---

<MainGridLayout>
    {page.currentPage === 1 && <section class="gate-intro card-base">
        <div class="gate-hero-copy">
            <span class="gate-eyebrow"><i></i> dominator / ENGINEERING JOURNAL</span>
            <h1>把好奇心，<br />写成<em>可运行的答案。</em></h1>
            <p>拆开 AI，理解它如何工作。<br />在公式、代码与实验之间，记录每一次认知的迭代。</p>
            <div class="gate-hero-actions"><a class="gate-cta" href="#journal">开始阅读 <span aria-hidden="true">↗</span></a><a class="gate-text-link" href="/about/">关于这个博客 →</a></div>
        </div>
        <div class="gate-hero-art" aria-hidden="true">
            <div class="gate-orbit orbit-one"></div><div class="gate-orbit orbit-two"></div>
            <div class="gate-portrait-frame"><img src="/images/dominator-avatar.png" width="1254" height="1254" alt="" fetchpriority="high" /></div>
            <div class="gate-art-label label-top">DOMINATOR / BLUE HOUR</div>
            <div class="gate-art-label label-bottom"><span></span> STAY CURIOUS. KEEP BUILDING.</div>
        </div>
        <div class="gate-topics"><span>探索方向</span><a href="/about/#写作方向">模型原理</a><a href="/about/#写作方向">检索增强</a><a href="/about/#写作方向">Agent</a><a href="/about/#写作方向">工程实践</a></div>
    </section>}
    {page.currentPage === 1 && <div id="journal" class="gate-section-heading"><div><span class="gate-eyebrow">THE JOURNAL</span><h2>最近的记录<span> / Notes & experiments</span></h2></div><a href="/archive/">全部文章 ↗</a></div>}
    <PostPage page={page}></PostPage>
    <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
</MainGridLayout>