---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import LetterCover from '@/components/LetterCover.astro';
import { entries, entryUrl, dateLabel, weekdayLabel } from '@/lib';
import { site } from '@/config';
const notes=(await entries()).filter(p=>p.collection==='notes');
const latest=notes[0];
const { Content }=await render(latest);
const years=[...new Set(notes.slice(1).map(note=>note.data.date.getUTCFullYear()))];
---
<Base title="手记列表"><section class="notes-page replica-container"><div class="collection-filter-state" data-note-filter hidden><span></span><a href="/notes/">查看全部手记 →</a></div><p class="collection-filter-empty" data-note-empty hidden>这个专栏暂时没有手记。</p><article class="featured-letter paper-panel" data-note-item data-note-category={latest.data.category}>
  <div class="featured-letter-top"><LetterCover/><div class="letter-cover-heading"><div class="letter-cover-meta"><span>{latest.data.category}</span>{latest.data.mood&&<><span>·</span><span>{latest.data.mood}</span></>}<span>·</span><time datetime={latest.data.date.toISOString()}>{dateLabel(latest.data.date)}</time></div><h1>{latest.data.title}</h1></div></div>
  <div class="letter-excerpt"><div class="prose letter-preview-prose"><Content/></div><div class="letter-fade" aria-hidden="true"></div></div>
  <div class="letter-footer"><span>{site.author.toUpperCase()} · LETTER № {notes.length}</span><a href={entryUrl(latest)}>阅读全文 →</a></div>
</article><div class="letters-divider"><span>更早的手记</span></div>
{years.map(year=><section class="letter-year-group"><div class="letter-year-heading"><div><span>ANNO</span><strong>{year}</strong></div><span>{notes.slice(1).filter(n=>n.data.date.getUTCFullYear()===year).length} LETTERS</span></div><div class="older-letters">{notes.slice(1).filter(n=>n.data.date.getUTCFullYear()===year).map(note=><article class="older-letter" data-note-item data-note-category={note.data.category}><div class="letter-date-block"><strong>{String(note.data.date.getUTCDate()).padStart(2,'0')}</strong><span>{note.data.date.getUTCMonth()+1}月</span><small>{weekdayLabel(note.data.date)}</small></div><a class="older-letter-main" href={entryUrl(note)}><LetterCover small/><div class="older-letter-text"><div class="older-note-meta"><span>{note.data.category}</span>{note.data.mood&&<span>{note.data.mood}</span>}</div><h2>{note.data.title}</h2><p>{note.data.description}</p><div class="letter-footer"><span>LETTER № {notes.length-notes.indexOf(note)}</span><span>阅读全文 →</span></div></div></a></article>)}</div></section>)}
<div class="replica-pagination"><p>平凡的日子，也有微光。</p></div></section></Base>
