---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { entries, entryUrl, collectionLabel } from '@/lib';
const all=await entries();
const date=new Date(new Intl.DateTimeFormat('en-CA',{timeZone:'America/New_York'}).format(new Date())+'T12:00:00Z');
const year=date.getUTCFullYear();
const elapsed=Math.ceil((Date.UTC(year,date.getUTCMonth(),date.getUTCDate())-Date.UTC(year,0,0))/86400000);
const days=(Date.UTC(year+1,0,1)-Date.UTC(year,0,1))/86400000;
const years=[...new Set(all.map(item=>item.data.date.getUTCFullYear()))];
const monthNames=['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
---
<Base title="时间线"><section class="timeline-page"><div class="timeline-topbar"><span>时间线</span><div><button class="active" data-timeline-density="relaxed" aria-pressed="true">舒</button><button data-timeline-density="compact" aria-pressed="false">密</button><button data-timeline-density="overview" aria-pressed="false">概览</button><button data-search-open><Icon name="search" size={14}/> 搜索</button></div></div><div class="timeline-total"><strong>{all.length}</strong><span>篇，再接再厉</span></div><div class="time-progress"><div><strong data-day-of-year>{elapsed}</strong><span>今年第几天</span></div><div><strong><span data-year-progress>{Math.floor(elapsed/days*100)}</span><small>%</small></strong><span>年度进度</span></div></div><p class="timeline-motto">活在当下，珍惜眼下</p><div class="timeline-years" data-timeline-list>
{years.map(entryYear=><section class="timeline-year-section"><div class="timeline-year"><strong>{entryYear}</strong><span>本年 {all.filter(p=>p.data.date.getUTCFullYear()===entryYear).length} 篇</span></div>{[...new Set(all.filter(p=>p.data.date.getUTCFullYear()===entryYear).map(p=>p.data.date.getUTCMonth()))].map(month=><div class="timeline-month"><h2>{month+1}月 · {monthNames[month]}</h2>{all.filter(p=>p.data.date.getUTCFullYear()===entryYear&&p.data.date.getUTCMonth()===month).map(item=><a class="timeline-row" href={entryUrl(item)}><time datetime={item.data.date.toISOString()}>{String(item.data.date.getUTCDate()).padStart(2,'0')}</time><span>{item.data.title}</span><small>{item.data.category} · {collectionLabel[item.collection]}</small></a>)}</div>)}</section>)}
</div></section></Base>
