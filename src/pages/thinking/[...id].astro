---
import Base from '@/layouts/Base.astro';
import { legacyThoughtIds } from '@/lib';
export function getStaticPaths() {
  return legacyThoughtIds.map(id=>({params:{id},props:{destination:`/notes/${id}/`}}));
}
const { destination } = Astro.props;
---
<Base title="这篇思考已收进手记" redirectTo={destination}><section class="empty-page"><h1>这篇思考已收进手记</h1><a href={destination}>继续阅读 →</a></section></Base>
