---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Placeholder from '@/components/Placeholder.astro';
import { site } from '@/config';
import { entries } from '@/lib';
const all = await entries();
---
<Base home>
  <section class="reference-hero">
    <div class="reference-hero-intro"><img class="reference-avatar" src="/images/avatar.svg" width="112" height="112" alt={`${site.author}头像`}/><h1><span>Hi, I'm </span><strong>{site.author}</strong><span class="reference-wave"> 👋</span><br/><span>I turn <em>ideas</em> into things with </span><span class="ai-spark">✦</span><code class="ai-pill">Creativity</code><span class="typing-cursor"></span></h1><p class="reference-tagline">A PERSONAL SPACE FOR IDEAS, CREATION, AND EVERYDAY LIFE.</p></div>
    <div class="reference-hero-bottom"><div class="quote-placeholder">「 <Placeholder widths={[100]} /> 」</div><div class="reference-stats"><span>{all.length} 篇</span><i>·</i><span>0 万字</span><i>·</i><span>从此刻开始</span></div><div class="social-links"><a href="/rss.xml" aria-label="RSS订阅"><Icon name="rss" size={18}/></a><button data-search-open aria-label="搜索本站"><Icon name="search" size={18}/></button><a href="/message/" aria-label="留言"><Icon name="mail" size={18}/></a><a href="/about/" aria-label="关于dominator"><Icon name="leaf" size={18}/></a></div></div>
  </section>
  <section class="reference-home-columns">
    <div class="home-writing"><div class="reference-section-title"><span>RECENT WRITING</span><h2>近期笔墨</h2></div><div class="home-writing-track" aria-label="近期文章版式占位">{Array.from({length:5},(_,i)=><a class:list={['home-writing-placeholder',{'first':i===0}]} href={i%2===0?'/preview/post/':'/preview/note/'} aria-label={`预览${i%2===0?'文稿':'手记'}版式`}><span class="track-number">{String(i+1).padStart(2,'0')}</span><Placeholder widths={[i===0?21:65]}/><Placeholder title={i===0} widths={[i===0?79:36]}/></a>)}</div></div>
    <aside class="home-marginalia"><div><div class="reference-section-title"><span>MUSINGS</span><h2>碎念</h2></div><div class="home-musing-placeholder"><Placeholder widths={[100,87,54]}/><a href="/thinking/" aria-label="查看思考"><Icon name="arrow" size={16}/></a></div></div><div><div class="reference-section-title"><span>LETTERS</span><h2>来信</h2></div><div class="home-letter-placeholder"><Placeholder widths={[85,100,45]}/><a href="/notes/" aria-label="查看手记"><Icon name="arrow" size={16}/></a></div></div></aside>
  </section>
  <section class="home-mail-panel"><div class="mail-panel-paper paper-panel"><span class="season-caption-label">深秋叶丹</span><div class="mail-panel-content"><span class="season-decoration" aria-hidden="true">✳</span><div><span class="eyebrow">A LETTER, A CONNECTION</span><h2>欢迎来信</h2></div><div class="mail-panel-actions"><a href="/message/">留下印记 <span>♥</span></a><button data-subscribe-open>订阅通信 <Icon name="arrow" size={15}/></button><p>不错过每一纸书。</p></div></div><div class="mail-panel-links">{site.more.map((item,i)=><>{i>0&&<span>·</span>}<a href={item.href}>{item.label==='友链'?'朋友们':item.label}</a></>)}</div></div></section>
</Base>
