---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import EntryList from '@/components/EntryList.astro';
import { site } from '@/config';
import { entries } from '@/lib';
const all = await entries();
const featured = site.featured;
const words = all.reduce((sum, p) => sum + (p.body?.length || 0), 0);
---
<Base home>
  <section class="hero">
    <div class="hero-orbit" aria-hidden="true"></div>
    <div class="falling-leaves" aria-hidden="true">{Array.from({ length: 9 }, (_, i) => <span style={`--i:${i};--x:${[9, 24, 82, 69, 16, 91, 75, 37, 58][i]}%;--y:${[18, 54, 25, 66, 81, 72, 12, 16, 86][i]}%`}>✦</span>)}</div>
    <div class="hero-intro">
      <div class="avatar-wrap"><img class="hero-avatar" src="/images/avatar.svg" width="96" height="96" alt={`${site.author} 的字母 d 个人标识`} /><span class="avatar-spark">✧</span></div>
      <div class="hero-eyebrow">{site.hero.eyebrow}</div>
      <h1>Hi, I'm <strong>{site.author}</strong><span class="wave">👋</span><br /><span class="hero-line">I turn <em>ideas</em> into <span class="shimmer">real things<span>✦</span></span><span class="cursor"></span></span></h1>
      <p class="hero-description">{site.hero.description}<span>{site.hero.aside}</span></p>
    </div>
    <div class="hero-bottom">
      <p class="hero-quote">「 {site.hero.quote} 」</p>
      <div class="hero-stats"><span>{all.length} 篇文字</span><i>·</i><span>{(words / 1000).toFixed(1)} k 字</span><i>·</i><span>无限的可能</span></div>
      <div class="social-links">{site.github && <a href={site.github} target="_blank" rel="noreferrer" aria-label="GitHub"><Icon name="github" size={18} /></a>}<a href="/rss.xml" aria-label="RSS 订阅"><Icon name="rss" size={18} /></a>{site.email && <a href={`mailto:${site.email}`} aria-label="发邮件"><Icon name="mail" size={18} /></a>}<a href="/archive/" aria-label="浏览时光归档"><Icon name="book" size={18} /></a><a href="/about/" aria-label="关于我"><Icon name="leaf" size={18} /></a></div>
    </div>
    <a href="#writing" class="scroll-cue"><span>向下，遇见一些日常</span><span>↓</span></a>
    <span class="hero-side-note">DESIGN · CODE · EVERYDAY LIFE</span>
  </section>
  <section id="writing" class="home-content container">
    <div class="writing-column reveal">
      <div class="section-heading"><div><span class="eyebrow">RECENT WRITING</span><h2>近期笔墨<span class="heading-dot">.</span></h2></div><a href="/posts/" class="text-link">所有文稿 <Icon name="arrow" size={16} /></a></div>
      <EntryList items={all.slice(0, 5)} featured />
      <a href="/archive/" class="archive-link">沿着时间的线，继续阅读 <Icon name="arrow" size={15} /></a>
    </div>
    <aside class="home-aside reveal">
      <div class="season-heading"><span class="eyebrow">A SPACE IN THE MAKING</span><span class="season-badge"><i></i> {featured.label}</span></div>
      <a href={featured.href} class="season-card"><div class="season-image"><img src={featured.image} alt={featured.imageAlt} width="600" height="380" loading="lazy" /><span>{featured.date}</span></div><div class="season-caption"><h3>{featured.title}</h3><Icon name="diagonal" size={18} /></div><p>{featured.description}</p></a>
      <div class="letter-note"><div class="letter-icon"><Icon name="leaf" size={23} /></div><div><h3>关于 dominator</h3><p>这个空间背后的人，与一些想法。</p></div><a href="/about/" aria-label="了解 dominator"><Icon name="arrow" size={19} /></a></div>
      <a class="rss-note" href="/rss.xml"><Icon name="rss" size={15} /><span>订阅 RSS，让文字自然抵达。</span><Icon name="diagonal" size={13} /></a>
    </aside>
  </section>
  <section class="project-section container reveal" aria-labelledby="project-title">
    <div class="section-heading"><div><span class="eyebrow">CURRENTLY BUILDING</span><h2 id="project-title">正在构建<span class="heading-dot">.</span></h2></div><span class="project-status"><i></i> 持续生长中</span></div>
    <a class="project-card" href={site.project.href}>
      <div class="project-mark" aria-hidden="true">d<span>✦</span></div>
      <div class="project-copy"><span class="project-kicker">A SMALL IDEA, MADE REAL <b>{site.project.version}</b></span><h3>{site.project.title}</h3><p>{site.project.description}</p><div class="project-tags">{site.project.tags.map(tag => <span>{tag}</span>)}</div></div>
      <span class="project-open"><Icon name="diagonal" size={23} /><span>阅读构建记录</span></span>
    </a>
  </section>
  <section class="home-epilogue container reveal"><span>✳</span><p>不必追赶所有的风景。<br />这里，收集一些值得停留的瞬间。</p><span class="epilogue-label">MAKE ROOM FOR THE LITTLE THINGS.</span></section>
</Base>
