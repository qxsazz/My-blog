---
import Base from '@/layouts/Base.astro';
import Placeholder from '@/components/Placeholder.astro';
import { site } from '@/config';
---
<Base title="关于我"><section class="about-replica replica-container"><header><span class="eyebrow">ABOUT</span><h1>关于我</h1></header><div class="about-identity"><img src={site.avatar} width="84" height="84" alt={`${site.author}的头像`}/><div><h2>{site.author}</h2><span>本站创建者</span></div></div><div class="about-content-placeholder" aria-label="个人介绍版式占位"><Placeholder widths={[100,100,85]}/><Placeholder title widths={[30]}/><Placeholder widths={[100,100,100,72]}/><Placeholder title widths={[25]}/><Placeholder widths={[100,100,67]}/></div></section></Base>
