---
import { render } from 'astro:content';
import Article from '@/layouts/Article.astro';
import { entries } from '@/lib';
export async function getStaticPaths() {
  const all = await entries();
  return all.filter(p=>p.collection==='posts').map(entry => ({params:{id:entry.id},props:{entry,next:all[(all.indexOf(entry)+1)%all.length]}}));
}
const { entry, next } = Astro.props;
const { Content, headings } = await render(entry);
---
<Article entry={entry} headings={headings} next={next}><Content /></Article>
