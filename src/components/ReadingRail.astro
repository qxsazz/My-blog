---
interface Props { outline: { depth: number; slug: string; text: string }[] }
---
<nav class="reading-rail reading-orbit" aria-label="阅读进度与目录" data-reading-rail hidden>
  <div class="reading-orbit-symbol" role="progressbar" aria-label="文章阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-reading-orbit-status>
    <svg viewBox="0 0 44 44" width="44" height="44" aria-hidden="true"><g transform="rotate(-90 22 22)"><circle class="orbit-track" cx="22" cy="22" r="19"/><circle class="orbit-progress" cx="22" cy="22" r="19" pathLength="100" data-reading-orbit/></g></svg>
    <span class="reading-orbit-percent" data-reading-progress aria-hidden="true">0%</span>
  </div>
  <div class="reading-rail-label"><span class="reading-orbit-caption">阅读进度</span><span data-reading-current-title>正文开篇</span></div>
  <button class="reading-guide-toggle" data-reading-guide-toggle aria-label="展开目录与阅读设置" aria-expanded="false" aria-controls="reading-outline-expanded">目录与设置 <span aria-hidden="true">↗</span></button>
</nav>
