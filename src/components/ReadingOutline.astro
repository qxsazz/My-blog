---
interface Props { outline: { depth: number; slug: string; text: string }[]; note: boolean; enhanced?: boolean }
const { outline, note, enhanced = false } = Astro.props;
---
<p class:list={{'reading-outline-heading':enhanced}}>此页目录{enhanced && <span class="outline-count">{String(outline.length).padStart(2,'0')} 节</span>}</p>
<nav class:list={{'reading-outline-menu':enhanced}}>{outline.length ? outline.map(h => <a href={`#${h.slug}`} class:list={{'toc-nested':h.depth===3}}>{h.text}</a>) : <a href="#article-body">正文</a>}</nav>
<div class="reading-tools">
  <div class="reading-progress-row"><span>阅读进度</span>{enhanced ? <div class="reading-progress-status" role="progressbar" aria-label="文章阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-reading-progressbar><svg class="reading-progress-ring" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8"/><circle cx="10" cy="10" r="8" pathLength="100" data-reading-ring /></svg><span data-reading-progress>0%</span></div> : <span data-reading-progress>0%</span>}</div>
  {enhanced && <div class="reading-progress-meter" aria-hidden="true"><span data-reading-meter></span></div>}
  <div class="reading-font-controls"><span>正文字体</span><button data-reading-font="serif" aria-pressed={note}>宋体</button><button data-reading-font="sans" aria-pressed={!note}>黑体</button></div>
  <a href="#main" class="toc-top">回到开头 ↑</a>
</div>
