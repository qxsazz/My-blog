---
import '@fontsource-variable/jetbrains-mono';
interface Props {class?:string;}
---
<div class={Astro.props.class||'reading-body'} data-pagefind-body><slot /></div>
<script>
 document.addEventListener('click',async event=>{
  const target=(event.target as Element).closest<HTMLElement>('.copy-btn');if(!target)return;
  const pre=target.closest('pre');const lines=[...(pre?.querySelectorAll('.code:not(summary *)')||[])];
  const text=lines.map(line=>line.textContent==='\n'?'':line.textContent).join('\n');
  try{await navigator.clipboard.writeText(text);target.classList.add('success');setTimeout(()=>target.classList.remove('success'),1200);}catch{target.setAttribute('aria-label','复制未成功，请手动选择代码');}
 });
</script>
