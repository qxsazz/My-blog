---
import { site } from '@/config';
import { entries } from '@/lib';
import Icon from './Icon.astro';
interface Props { mobile?: boolean }
const { mobile = false } = Astro.props;
const all = await entries();
// Count visible writing, excluding Markdown syntax, destinations and whitespace.
const characters = Array.from(all.map(item => (item.body || '').replace(/```[^\n]*\n/g, '').replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1').replace(/<[^>]*>/g, '').replace(/[\s#*_`~>|-]/g, '')).join('')).length;
const days = Math.max(1, Math.floor((Date.now() - Date.parse(`${site.since}T00:00:00Z`)) / 86400000) + 1);
const path = Astro.url.pathname;
const suffix = mobile ? 'mobile' : 'desktop';
const repository = site.repository || site.github;
---
<div class:list={['mega-panel', {'mega-panel-mobile':mobile}]}>
  <section class="mega-overview" aria-labelledby={`mega-overview-${suffix}`}>
    <h2 id={`mega-overview-${suffix}`}>此间</h2>
    <dl class="mega-statistics">
      <div><dt>篇文字</dt><dd><a href="/timeline/" aria-label={`共 ${all.length} 篇文字`}>{all.length}</a></dd></div>
      <div><dt>{characters >= 10000 ? '万字' : '字'}</dt><dd>{characters >= 10000 ? (characters / 10000).toFixed(1) : characters.toLocaleString('zh-CN')}</dd></div>
      <div><dt>日</dt><dd data-site-since={site.since}>{days}</dd></div>
    </dl>
    <div class="mega-socials" aria-label="订阅与联系">
      <a href="/rss.xml" data-astro-reload aria-label="RSS 订阅" title="RSS 订阅"><Icon name="rss" size={17}/></a>
      {site.email && <a href={`mailto:${site.email}`} aria-label="电子邮件" title={`发送邮件 · ${site.email}`}><Icon name="mail" size={18}/></a>}
      {repository && <a href={repository} target="_blank" rel="noopener noreferrer" aria-label="GitHub 仓库：本站源码" title="GitHub · 本站源码"><Icon name="github" size={18}/></a>}
      <button data-search-open aria-label="搜索本站" title="搜索本站"><Icon name="search" size={17}/></button>
    </div>
  </section>
  <section class="mega-directory" aria-labelledby={`mega-directory-${suffix}`}>
    <h2 id={`mega-directory-${suffix}`}>页面</h2>
    <div class="mega-page-links">{site.pages.map(item => <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>)}</div>

  </section>
</div>
