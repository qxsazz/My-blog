---
import { entries, entryUrl, collectionLabel } from '@/lib';
import Icon from './Icon.astro';
const index = (await entries()).map(p => ({ title: p.data.title, description: p.data.description, category: p.data.category, tags: p.data.tags, body: p.body, date: p.data.date.toISOString(), url: entryUrl(p), type: collectionLabel[p.collection] }));
---
<dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title">
  <div class="search-top"><Icon name="search" /><label id="search-title" class="sr-only" for="search-input">搜索文章与手记</label><input id="search-input" type="search" placeholder="寻找一段文字、一个想法…" autocomplete="off" aria-controls="search-results" aria-describedby="search-summary" /><button class="icon-button" data-search-close aria-label="关闭搜索"><Icon name="close" /></button></div>
  <div class="search-meta"><span id="search-summary" role="status" aria-live="polite">搜索本站</span><kbd>ESC 关闭</kbd></div>
  <div id="search-results" class="search-results" aria-live="polite"></div>
  <div class="search-keyboard-help" aria-hidden="true"><span><kbd>↑</kbd><kbd>↓</kbd> 选择</span><span><kbd>↵</kbd> 打开</span><span><kbd>esc</kbd> 关闭</span></div>
  <script id="search-index" type="application/json" set:html={JSON.stringify(index).replace(/</g, '\\u003c')} />
</dialog>
