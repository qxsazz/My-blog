---
import { entries, entryUrl } from '@/lib';
import Icon from './Icon.astro';
const index = (await entries()).map(p => ({ title: p.data.title, description: p.data.description, category: p.data.category, tags: p.data.tags, body: p.body, url: entryUrl(p), type: p.collection === 'posts' ? '文稿' : '手记' }));
---
<dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title">
  <div class="search-top"><Icon name="search" /><label id="search-title" class="sr-only" for="search-input">搜索文章与手记</label><input id="search-input" type="search" placeholder="寻找一段文字、一个想法…" autocomplete="off" /><button class="icon-button" data-search-close aria-label="关闭搜索"><Icon name="close" /></button></div>
  <div class="search-meta"><span>在文字之间，发现一点共鸣</span><kbd>ESC 关闭</kbd></div>
  <div id="search-results" class="search-results" aria-live="polite"></div>
  <script id="search-index" type="application/json" set:html={JSON.stringify(index).replace(/</g, '\\u003c')} />
</dialog>
