---
import Icon from './Icon.astro';
import { entries } from '@/lib';
const posts=(await entries()).filter(p=>p.collection==='posts');
const tags=[...new Set(posts.flatMap(p=>p.data.tags))].map(tag=>({tag,count:posts.filter(p=>p.data.tags.includes(tag)).length})).sort((a,b)=>b.count-a.count);
---
<dialog id="tags-dialog" class="small-dialog" aria-labelledby="tags-title"><div class="dialog-title"><h2 id="tags-title">全部标签</h2><button class="icon-button" data-tags-close aria-label="关闭标签"><Icon name="close"/></button></div><div class="real-tag-cloud"><a href="/posts/" data-post-tag="">全部文稿 <span>{posts.length}</span></a>{tags.map(({tag,count})=><a href={`/posts/?tag=${encodeURIComponent(tag)}`} data-post-tag={tag}>{tag} <span>{count}</span></a>)}</div></dialog>
