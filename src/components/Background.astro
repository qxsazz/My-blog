---
// 稳定的纸纤维与季节点缀；不加载参考站的脚本、跟踪器或任何文章内容。
const random = (i: number, salt = 1) => { const x = Math.sin(i * 127.1 + salt * 311.7) * 43758.5453; return x - Math.floor(x); };
---
<div class="site-background" aria-hidden="true"><svg class="paper-fibres" width="100%" height="100%" viewBox="0 0 1440 1050" preserveAspectRatio="xMidYMid slice"><defs><filter id="grain"><feTurbulence type="fractalNoise" baseFrequency=".78" numOctaves="3" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter></defs><rect width="1440" height="1050" filter="url(#grain)" opacity=".045"/>{Array.from({length:75},(_,i)=>{const x=random(i)*1440,y=random(i,2)*1050;return <path d={`M${x} ${y} q${random(i,3)*400-200} ${random(i,4)*400-200} ${random(i,5)*700-350} ${random(i,6)*450-225}`} fill="none" stroke="white" stroke-width={random(i,7)*1.4+.25} opacity={random(i,8)*.4+.1}/>;})}{Array.from({length:190},(_,i)=><ellipse cx={random(i,11)*1440} cy={random(i,12)*1050} rx={random(i,13)*1.7+.4} ry={random(i,14)*2.3+.5} fill={['#c4aa80','#b59f8d','#b6896d'][i%3]} opacity={random(i,15)*.2+.08}/>)}</svg><div class="season-leaves">{Array.from({length:25},(_,i)=><svg class="season-leaf" viewBox="0 0 30 30" style={`--x:${random(i,21)*100}%;--y:${random(i,22)*100}%;--size:${random(i,23)*12+10}px;--rotation:${random(i,24)*360}deg;--delay:${-random(i,25)*25}s;--speed:${random(i,26)*15+20}s;--leaf-color:${['#bc8066','#be9d68','#9eab7e'][i%3]}`}><path d="m15 1 3 6 4-2-1 7 7 1-4 5 2 4-8-1-2 8-2-8-8 2 1-5-5-4 7-2-1-7 4 2Z" fill="currentColor"/></svg>)}</div></div>
