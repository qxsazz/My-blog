---
import '@/styles/note-cover.css';
interface Props { small?: boolean; id?: string }
const { small = false } = Astro.props;
---
<div class:list={['letter-cover', 'note-cover-illustrated', { small }]} aria-hidden="true">
  <img class="note-cover-image note-cover-night" src="/images/notes/moonlit-journal.webp" width="2135" height="736" alt="" loading={small ? 'lazy' : 'eager'} fetchpriority={small ? 'low' : 'high'} decoding="async" draggable="false"/>
  <img class="note-cover-image note-cover-day" src="/images/notes/daylight-journal.webp" width="2135" height="736" alt="" loading={small ? 'lazy' : 'eager'} fetchpriority={small ? 'low' : 'high'} decoding="async" draggable="false"/>
</div>
