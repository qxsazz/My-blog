---
// 与手记封面相同的渐进频率波形，使用确定性的本地 SVG。
interface Props { small?: boolean }
const { small = false } = Astro.props;
const points = Array.from({length:1700},(_,i)=>{const x=i/1699*1000,t=x/1000;const y=150+Math.sin(t*t*150)*Math.sin(Math.PI*t)*42;return `${x.toFixed(2)},${y.toFixed(2)}`}).join(' ');
---
<div class:list={['letter-cover',{'small':small}]} aria-hidden="true"><svg viewBox="0 0 1000 220" preserveAspectRatio="none"><path d="M0 150H1000" stroke="currentColor" opacity=".18" fill="none"/><polyline points={points} fill="none" stroke="currentColor" stroke-width="1.1" opacity=".5"/><circle cx="978" cy="150" r="6" fill="var(--accent)" opacity=".5"/></svg></div>
