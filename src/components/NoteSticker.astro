---
interface Props { kind: 'annual' | 'review' | 'travel' | 'thought' | 'game' }
const { kind } = Astro.props;
---
<svg class={`note-sticker sticker-${kind}`} width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
  <path d="M5 2.5 20 3.2 21.5 20 4 21.5 2.5 5Z" fill="#f4eddb" stroke="#cbbfa9" stroke-width=".65"/>
  {kind==='annual' && <>
    <path d="M6 5h12v14H6z" fill="#b88c64" stroke="#876548" stroke-width=".75"/>
    <path d="M8.5 5v14" stroke="#dfbd93"/><path d="M14 5v5l1.5-1 1.5 1V5" fill="#e9c7a1"/>
    <path d="M11 12h5m-5 3h4" stroke="#fff0cf" stroke-width=".9" stroke-linecap="round"/>
  </>}
  {kind==='review' && <>
    <path d="m7 5 9-.7 2.6 3.1.7 11.1-11.7.7Z" fill="#dae4e5" stroke="#7c939f" stroke-width=".75"/>
    <path d="m16 4.3.1 3.7 2.5-.6" fill="#a5b8c2"/><path d="m9 10 1 1 1.7-2m1 1h3M9.5 14l1 1 1.7-2m1 1h3" stroke="#647e91" stroke-width=".85" stroke-linecap="round" stroke-linejoin="round"/>
  </>}
  {kind==='travel' && <>
    <path d="m5 7 4-2 6 2 4-2v13l-4 2-6-2-4 2Z" fill="#d1ddcb" stroke="#7c9488" stroke-width=".7"/>
    <path d="M9 5v13m6-11v13" stroke="#a5b7a1"/><path d="m7 14 4-4 5 3" stroke="#fff8dd" stroke-width="1.4" stroke-linecap="round" stroke-dasharray="1 2"/>
    <path d="M17 8a2 2 0 0 0-2 2c0 1.3 2 3 2 3s2-1.7 2-3a2 2 0 0 0-2-2Z" fill="#ad8268"/><circle cx="17" cy="10" r=".7" fill="#fff5d8"/>
  </>}
  {kind==='thought' && <>
    <path d="M6 6.5c2-2.5 9-3 12 1 2.4 3.8-.6 7.8-5.6 7.5L8 18l.6-4.2C5 12.9 4 9 6 6.5Z" fill="#b8adc9" stroke="#8f82a8" stroke-width=".75"/>
    <path d="m12.5 6.8.8 2.3 2.5.6-2.2 1.3-.3 2.5-1.5-2-2.4.5 1.4-2.1-.9-2.3 2.2.9Z" fill="#fff0cb"/><circle cx="17" cy="16.8" r="1" fill="#a89bb9"/>
  </>}
  {kind==='game' && <>
    <rect x="6" y="4.5" width="12" height="15" rx="2" fill="#a1bed1" stroke="#698aa3" stroke-width=".75"/>
    <rect x="8" y="6.5" width="8" height="6.5" rx=".7" fill="#607d96"/><path d="m10 10 1.5-1.5 2 2 1-1" stroke="#d5e9e5" stroke-width=".8" stroke-linecap="round"/>
    <path d="M8.5 16h3m-1.5-1.5v3" stroke="#4f6d88" stroke-width="1.1" stroke-linecap="round"/><circle cx="14.5" cy="16.7" r=".85" fill="#b286a0"/><circle cx="16.5" cy="15.2" r=".85" fill="#ece1c4"/>
  </>}
</svg>
