<div id="gate-wallpaper" aria-hidden="true"></div>
<div id="gate-glow" aria-hidden="true"></div>
<aside id="gate-controls" aria-label="阅读氛围播放器" data-playing="false" data-swup-ignore-script>
  <div class="gate-player-main">
    <span class="gate-equalizer" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <div class="gate-player-copy"><strong id="gate-track-title">月光钢琴</strong><p id="gate-audio-status" role="status" aria-live="polite">让思绪慢下来 · 点击播放</p></div>
    <button id="gate-audio-button" type="button" aria-pressed="false" aria-label="播放轻音乐">▶</button>
  </div>
  <details><summary>声音与阅读氛围</summary>
    <div class="gate-player-settings">
      <label>音乐场景<select id="gate-scene"><option value="piano">月光钢琴</option><option value="cloud">云端漫游</option><option value="rain">雨夜书房</option></select></label>
      <label class="gate-volume">音量 <span><input id="gate-volume" type="range" min="0" max="100" value="30" aria-label="轻音乐音量" /> <output id="gate-volume-value">30%</output></span></label>
      <div class="gate-player-tools"><button id="gate-wallpaper-button" type="button" aria-label="切换壁纸">壁纸 · 苍蓝星域</button><button id="gate-effects-button" type="button" aria-pressed="true">星光特效</button></div>
    </div>
  </details>
</aside>
<script>
  import { ReadingAudio, type SoundScene } from "../scripts/reading-audio";
  const root = document.documentElement;
  // Swup may execute page scripts again; keep one audio engine and one set of listeners.
  if (!root.dataset.gateInitialized) {
  root.dataset.gateInitialized = "true";
  const wallpaper = document.querySelector<HTMLButtonElement>('#gate-wallpaper-button')!;
  const effects = document.querySelector<HTMLButtonElement>('#gate-effects-button')!;
  const music = document.querySelector<HTMLButtonElement>('#gate-audio-button')!;
  const volume = document.querySelector<HTMLInputElement>('#gate-volume')!;
  const status = document.querySelector<HTMLElement>('#gate-audio-status')!;
  const read = (key: string, fallback: string) => { try { return localStorage.getItem(key) ?? fallback; } catch { return fallback; } };
  const save = (key: string, value: string) => { try { localStorage.setItem(key, value); } catch { /* Storage is optional. */ } };
  const walls = ['苍蓝星域', '霜月极光', '纯净夜色'];
  let wall = Math.max(0, walls.indexOf(read('gate-wallpaper-blue', '苍蓝星域')));
  function setWall() { root.dataset.gateWallpaper = String(wall); wallpaper.textContent = `壁纸 · ${walls[wall]}`; }
  setWall();
  wallpaper.addEventListener('click', () => { wall = (wall + 1) % walls.length; setWall(); save('gate-wallpaper-blue', walls[wall]); });
  let enabled = read('gate-effects', 'true') === 'true';
  function setEffects() { root.dataset.gateEffects = String(enabled); effects.setAttribute('aria-pressed', String(enabled)); }
  setEffects();
  effects.addEventListener('click', () => { enabled = !enabled; setEffects(); save('gate-effects', String(enabled)); });
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = matchMedia('(pointer: fine)');
  let pending = false;
  let x = 0, y = 0;
  document.addEventListener('pointermove', (event) => {
    if (!enabled || reduced.matches || !finePointer.matches) return;
    x = event.clientX; y = event.clientY;
    if (pending) return;
    pending = true;
    requestAnimationFrame(() => {
      root.style.setProperty('--gate-x', `${x}px`); root.style.setProperty('--gate-y', `${y}px`);
      pending = false;
    });
  }, { passive: true });
  document.addEventListener('click', (event) => {
    if (!enabled || reduced.matches || !finePointer.matches || (event.target as Element).closest('button, a, input')) return;
    const ripple = document.createElement('span');
    ripple.className = 'gate-ripple'; ripple.style.left = `${event.clientX}px`; ripple.style.top = `${event.clientY}px`;
    document.body.append(ripple); ripple.addEventListener('animationend', () => ripple.remove(), { once: true });
  });
  const player = document.querySelector<HTMLElement>('#gate-controls')!;
  const scene = document.querySelector<HTMLSelectElement>('#gate-scene')!;
  const track = document.querySelector<HTMLElement>('#gate-track-title')!;
  const output = document.querySelector<HTMLOutputElement>('#gate-volume-value')!;
  const engine = new ReadingAudio();
  let playing = false;
  let busy = false;
  const storedScene = read('gate-scene', 'piano');
  scene.value = ['piano', 'cloud', 'rain'].includes(storedScene) ? storedScene : 'piano';
  track.textContent = scene.selectedOptions[0].textContent;
  const storedVolume = Number(read('gate-volume', '30'));
  volume.value = String(Number.isFinite(storedVolume) ? Math.min(100, Math.max(0, storedVolume)) : 30);
  output.value = `${volume.value}%`;
  engine.setVolume(Number(volume.value) / 100);
  function updatePlayer() {
    player.dataset.playing = String(playing);
    music.setAttribute('aria-pressed', String(playing));
    music.setAttribute('aria-label', playing ? '暂停轻音乐' : '播放轻音乐');
    music.textContent = playing ? 'Ⅱ' : '▶';
  }
  async function changePlayback(changeScene = false) {
    if (busy) return;
    busy = true; music.disabled = true; scene.disabled = true;
    try {
      const wasPlaying = playing;
      if (wasPlaying) { await engine.pause(); playing = false; }
      if (!wasPlaying || changeScene) { await engine.play(scene.value as SoundScene); playing = true; }
      status.textContent = playing ? '正在播放 · 专注此刻' : '已暂停 · 让思绪慢下来';
    } catch {
      await engine.pause(); playing = false;
      status.textContent = '暂时无法播放，请点击重试';
    } finally {
      updatePlayer(); busy = false; music.disabled = false; scene.disabled = false;
    }
  }
  music.addEventListener('click', () => changePlayback());
  scene.addEventListener('change', () => {
    save('gate-scene', scene.value);
    track.textContent = scene.selectedOptions[0].textContent;
    if (playing) void changePlayback(true);
  });
  volume.addEventListener('input', () => {
    save('gate-volume', volume.value); output.value = `${volume.value}%`;
    engine.setVolume(Number(volume.value) / 100);
  });
  }
</script>
