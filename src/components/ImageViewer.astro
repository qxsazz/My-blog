---
import Icon from './Icon.astro';
---
<dialog id="reader-image-dialog" class="reader-image-dialog" aria-labelledby="reader-image-title">
  <div class="reader-image-header"><span id="reader-image-title">图片预览</span><span data-reader-image-count aria-live="polite"></span><button type="button" data-reader-image-close aria-label="关闭图片预览"><Icon name="close" size={18}/></button></div>
  <figure><img data-reader-image alt="" decoding="async"/><figcaption data-reader-image-caption></figcaption></figure>
  <div class="reader-image-navigation"><button type="button" data-reader-image-prev aria-label="上一张图片">← 上一张</button><span>← → 切换 · Esc 关闭</span><button type="button" data-reader-image-next aria-label="下一张图片">下一张 →</button></div>
</dialog>
